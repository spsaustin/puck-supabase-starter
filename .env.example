# ── Supabase ─────────────────────────────────────────────────────────────
# The Vercel ↔ Supabase integration sets all of these on deploy. Locally, copy
# them from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never NEXT_PUBLIC_. The page store writes with this.
SUPABASE_SERVICE_ROLE_KEY=

# ── Who may edit ─────────────────────────────────────────────────────────
# Comma-separated Google accounts. The `admins` table is merged in too.
ADMIN_EMAILS=you@example.com

# ── Site ─────────────────────────────────────────────────────────────────
# Canonical origin, for sitemap and metadata. Vercel: your production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
